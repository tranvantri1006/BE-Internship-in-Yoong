@model IEnumerable<UIShoeStoreAPI.Models.Product>
@{
    ViewBag.Title = "Danh sách giày";
}
<h2>Danh sách giày</h2>
<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4">
            <div class="card" style="margin:10px;">
                <img src="@item.ImageUrl" alt="@item.Name" class="img-fluid" />
                <div class="card-body">
                    <h4>@item.Name</h4>
                    <p>Giá: @item.Price $</p>
                    <a href="@Url.Action("Details", "Products", new { id = item.Id })" class="btn btn-primary">Xem chi tiết</a>
                </div>
            </div>
        </div>
    }
</div>